, "a_t1", "a_t2", "a_t", "a_seal", "a_cv"]}, {"n": 12, "kind": "wm", "tag": "單色白", "svg": "12_我也是/字標_單色白.svg", "png": "12_我也是/字標_單色白.png", "w": 1140, "h": 400, "ids": ["w_nt", "w_txt"], "chk": [["dis", "w_nt", "w_txt"]]}], "meta": [{"n": 1, "name": "代·薪資線", "style": "字體設計", "meaning": "「代」的斜鉤是一條往下沉的薪資線，尾端翹起、迸出一點光", "dir": "01_代·薪資線"}, {"n": 2, "name": "門半開", "style": "剪紙疊層", "meaning": "「們」的門半開，縫裡漏出暖光：同代人的日子還有出口", "dir": "02_門半開"}, {"n": 3, "name": "一線串起的窗", "style": "單線一筆畫", "meaning": "一條線串起許多扇窗＝許多人過著相似的日子，最後一扇亮了", "dir": "03_一線串起的窗"}, {"n": 4, "name": "這一代·大樓", "style": "印刷疊字", "meaning": "「這」「一」「代」三字疊成一棟樓，只有一層亮著", "dir": "04_這一代·大樓"}, {"n": 5, "name": "十分之一的日出", "style": "幾何海報", "meaning": "日出被地平線壓住，只露出十分之一，但已經是天亮", "dir": "05_十分之一的日出"}, {"n": 6, "name": "觀察筆記書封", "style": "書封直排", "meaning": "像一本觀察筆記的書封，朱印「觀」是觀察家的落款", "dir": "06_觀察筆記書封"}, {"n": 7, "name": "我與你的重疊", "style": "手繪重疊圈", "meaning": "兩個手畫的圈，重疊那一小塊亮起：同代人才懂的同感", "dir": "07_我與你的重疊"}, {"n": 8, "name": "00 徽章", "style": "復古徽章", "meaning": "兩個零是 2000 後的記號，右邊那個零裡亮著一點光", "dir": "08_00 徽章"}, {"n": 9, "name": "剪刀差", "style": "編輯圖表線", "meaning": "房價線往上衝、薪水線幾乎平，夾出的斜線區就是處境，線尾一點光", "dir": "09_剪刀差"}, {"n": 10, "name": "點陣的代", "style": "像素點陣字", "meaning": "2000 後的第一批字是點陣字：每一格都小，連起來才成為我們，鉤尾一格亮", "dir": "10_點陣的代"}, {"n": 11, "name": "最新一圈", "style": "木刻年輪", "meaning": "年輪一圈就是一代，我們是最外那圈剛長出來的，一角亮著", "dir": "11_最新一圈"}, {"n": 12, "name": "我也是", "style": "手寫便利貼", "meaning": "同代人互相留下的那句「我也是」，貼在冷牆上，一張暖黃", "dir": "12_我也是"}], "tones": {"霧紫灰": {"bg": "#4A4454", "ink": "#F3EFF5", "line": "#ABA0B5", "acc": "#F2D88E", "deep": "#3A3544"}, "深夜藍": {"bg": "#1F2A3A", "ink": "#F1EBDD", "line": "#8FA3BC", "acc": "#F0C987", "deep": "#161E2B"}, "水泥暖灰": {"bg": "#56524D", "ink": "#F3EEE6", "line": "#BDB5A9", "acc": "#F3A93C", "deep": "#43403B"}, "灰綠": {"bg": "#3E4A44", "ink": "#EFEBDD", "line": "#A6B8AC", "acc": "#E3C98A", "deep": "#2F3934"}, "米白紙": {"bg": "#F1ECE3", "ink": "#26221F", "line": "#6B645C", "acc": "#C8372D", "deep": "#E2DACB"}, "