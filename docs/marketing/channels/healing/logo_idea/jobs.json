   "exp": "一扇窗同時是一隻眼睛：觀察家看見的，是每一戶只亮一格的窗。",
   "how": "兩個意象合一（窗＝眼）"
  },
  {
   "n": 2,
   "name": "放大鏡公寓",
   "exp": "放大鏡一照，一整面公寓牆，只有一扇窗亮著。",
   "how": "比例錯置＋小反差（放大鏡裡是整棟樓）"
  },
  {
   "n": 3,
   "name": "沙漏房子",
   "exp": "沙漏的兩個玻璃球是一正一倒的房子，時間往下掉，房子還是遠的。",
   "how": "雙關（沙漏＝等一間房）"
  },
  {
   "n": 4,
   "name": "鑰匙房價線",
   "exp": "鑰匙的齒是一條往上爬的房價線，終點那一點是暖黃。",
   "how": "兩個意象合一（鑰匙齒＝折線圖）"
  },
  {
   "n": 5,
   "name": "房子電池",
   "exp": "電池的形狀是一間房子，只充到了 3%。",
   "how": "兩個意象合一＋小反差（屋頂接電池頭）"
  },
  {
   "n": 6,
   "name": "燈泡套房",
   "exp": "一盞燈泡裡，住著一間亮著窗的小套房。",
   "how": "比例錯置（燈泡裡裝一個家）"
  },
  {
   "n": 7,
   "name": "窗拼人字",
   "exp": "整棟樓的窗，實心的那些拼成一個「人」字，頂端一格亮著。",
   "how": "負空間／像素拼字（窗＝人）"
  },
  {
   "n": 8,
   "name": "燈裡的人",
   "exp": "燈是實心的，三個站著的幾何人形是從燈裡挖出來的光，中間那顆頭亮著。",
   "how": "負空間（人形＝燈的缺口）"
  },
  {
   "n": 9,
   "name": "窗格向上",
   "exp": "窗格的直框長成一支向上的箭頭，箭尖是暖黃。",
   "how": "兩個意象合一（窗格＝箭頭）"
  },
  {
   "n": 10,
   "name": "月曆末格",
   "exp": "月曆最後一格，透出一點光。",
