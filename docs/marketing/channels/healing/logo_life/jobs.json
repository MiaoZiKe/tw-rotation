 "styles": [
  {
   "n": 1,
   "name": "電量3%",
   "exp": "手機永遠剩 3% 還在趕路、不敢離開插座的那個人。"
  },
  {
   "n": 2,
   "name": "租屋鑰匙",
   "exp": "鑰匙圈上掛的永遠是別人家的門牌：租了又搬、搬了又租。"
  },
  {
   "n": 3,
   "name": "末班座椅",
   "exp": "末班車廂一整排空座位、一根立柱，回家的路上只剩自己。"
  },
  {
   "n": 4,
   "name": "熱便當蒸氣",
   "exp": "一個人加班後微波的便當、泡麵，蒸氣是今天唯一的暖。"
  },
  {
   "n": 5,
   "name": "存款進度條",
   "exp": "存款簿上那條頭期款進度條，努力很久只填了一小段。"
  },
  {
   "n": 6,
   "name": "什麼時候",
   "exp": "過年飯桌上那句「什麼時候…？」，全家人都在等你回答。"
  },
  {
   "n": 7,
   "name": "室內帽T",
   "exp": "小套房沒陽台，帽 T 只能掛在室內衣架上慢慢晾乾。"
  },
  {
   "n": 8,
   "name": "小套房平面",
   "exp": "整個家只有一張床加一盞檯燈的小套房，一坪都不浪費。"
  },
  {
   "n": 9,
   "name": "一格有信",
   "exp": "一整排信箱只有一格有信，同棟的每個我們都過一樣的日子。"
  },
  {
   "n": 10,
   "name": "計算機0.695",
