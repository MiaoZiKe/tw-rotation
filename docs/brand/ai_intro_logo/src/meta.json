[{"k": "a1", "n": "終端游標", "m": "綠色「>」加琥珀色游標方塊：每個做法都是我親手在終端機跑過的，不是轉述。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a1_終端游標"}, {"k": "a2", "n": "勾與叉並陳", "m": "綠勾與琥珀叉兩塊同大：成功與翻車同樣大方攤開，這就是「透明」。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a2_勾與叉並陳"}, {"k": "a3", "n": "實測刻度", "m": "半圓量表加指針：用數字量過才下結論，不憑感覺。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a3_實測刻度"}, {"k": "a4", "n": "疊層證據", "m": "三層視窗疊起，最前面一層帶琥珀紀錄點：每個結論背後都有一疊截圖可查。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a4_疊層證據"}, {"k": "a5", "n": "日誌行", "m": "綠色行列中夾一行琥珀：上班日記，翻車那行也照實記下。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a5_日誌行"}, {"k": "a6", "n": "前後對照柱", "m": "矮灰柱對高綠柱立在同一條基準線：有沒有用，用前後對比說話。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a6_前後對照柱"}, {"k": "a7", "n": "放大驗證", "m": "放大鏡裡一個綠勾：「可驗證」，每一步你都能自己再做一次。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a7_放大驗證"}, {"k": "a8", "n": "實驗矩陣", "m": "3×3 格子，綠＝成功、空框＝沒做出來、右下琥珀＝翻車：一格一次實測。", "dir": "/home/user/tw-rotation/docs/brand/ai_intro_logo/src/../a8_實驗矩陣"}]